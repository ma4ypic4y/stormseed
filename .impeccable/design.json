      "html": "<button class=\"ds-method\" type=\"button\" aria-expanded=\"false\"><span>How it works</span><span class=\"ds-plus\" aria-hidden=\"true\"></span></button>",
      "css": ".ds-method{font-family:Apfel,sans-serif;border:0;background:none;padding:0;color:var(--ink,#f1f0e8);cursor:pointer;min-height:44px;transition:color .18s ease;display:inline-flex;align-items:center;gap:18px;font-size:16px}.ds-plus{position:relative;width:14px;height:14px}.ds-plus:before,.ds-plus:after{content:\"\";position:absolute;top:6px;left:0;width:14px;height:1.5px;background:currentColor}.ds-plus:after{transform:rotate(90deg)}.ds-method[aria-expanded=true] .ds-plus:after{transform:rotate(0)}.ds-method:hover{color:var(--red,#f0785c)}.ds-method:focus-visible{outline:2px solid var(--red,#f0785c);outline-offset:7px}@media(prefers-reduced-motion:reduce){.ds-method{transition:none}}"
