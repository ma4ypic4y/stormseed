      "kind": "button",
      "refersTo": "button-generate",
      "description": "Open action row with an ink rule and a salmon arrow disc.",
      "html": "<button class=\"ds-generate\"><span>Generate</span><span class=\"ds-action-disc\" aria-hidden=\"true\"><svg viewBox=\"0 0 32 32\"><path d=\"M7 25 25 7M7 7h18v18\"/></svg></span></button>",
      "css": ".ds-generate{font-family:Apfel,sans-serif;border:0;background:none;padding:0;color:var(--ink,#f1f0e8);cursor:pointer;min-height:44px;transition:color .18s ease;display:flex;gap:24px;align-items:center;justify-content:space-between;width:100%;max-width:420px;min-height:94px;border-top:1px solid var(--ink,#f1f0e8);font-size:clamp(29px,2.4vw,44px);letter-spacing:-.025em;text-align:left}.ds-action-disc{display:grid;place-items:center;flex:none;width:64px;height:64px;border-radius:50%;background:var(--red,#f0785c);color:var(--paper,#171815);transition:transform .3s cubic-bezier(.16,1,.3,1),background .2s}.ds-action-disc svg{width:29px;height:29px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-generate:hover:not(:disabled){color:var(--red,#f0785c)}.ds-generate:hover:not(:disabled) .ds-action-disc{transform:rotate(45deg);background:var(--ink,#f1f0e8)}.ds-generate:active:not(:disabled) .ds-action-disc{transform:scale(.9) rotate(45deg)}.ds-generate:disabled{opacity:.5;cursor:wait}.ds-generate:focus-visible{outline:2px solid var(--red,#f0785c);outline-offset:7px}@media(prefers-reduced-motion:reduce){.ds-generate,.ds-action-disc{transition:none}.ds-generate:hover:not(:disabled) .ds-action-disc{transform:none}}"
    },
