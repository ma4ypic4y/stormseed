    {
      "name": "Number result",
      "kind": "custom",
      "description": "Large display type bounded by its own container, with a separate three-digit scale.",
      "html": "<div class=\"ds-result-area\"><div class=\"ds-result-art\"><div class=\"ds-result ds-three-digits\" aria-hidden=\"true\">100</div></div><p class=\"ds-result-label\" role=\"status\">100 out of 100.</p></div>",
      "css": ".ds-result-area{container-type:inline-size;min-width:0;width:100%;max-width:800px;text-align:center;color:var(--ink,#f1f0e8)}.ds-result-art{position:relative;display:grid;place-items:center;min-height:360px;height:clamp(360px,49svh,720px)}.ds-result{font-family:Basteleur,serif;font-size:min(clamp(260px,min(33vw,61svh),720px),68cqw);font-weight:700;line-height:1;letter-spacing:-.04em;position:relative;transform:translateY(-.035em);white-space:nowrap}.ds-result.ds-three-digits{font-size:min(clamp(220px,min(26vw,51svh),570px),44cqw)}.ds-result-label{font:16px/1.5 Apfel,sans-serif;color:var(--muted,#a3a59b);margin:24px 0 0}@media(max-width:760px){.ds-result-art{height:clamp(230px,34svh,360px);min-height:230px}.ds-result{font-size:min(clamp(230px,68vw,360px),68cqw)}.ds-result.ds-three-digits{font-size:min(clamp(175px,53vw,280px),44cqw)}.ds-result-label{font-size:14px;margin-top:8px}}@media(min-width:761px) and (max-height:650px){.ds-result-art{height:260px;min-height:260px}.ds-result{font-size:min(300px,68cqw)}.ds-result.ds-three-digits{font-size:min(235px,44cqw)}.ds-result-label{margin-top:5px}}"
