      "css": ".ds-die-result{text-align:center;color:var(--ink,#f1f0e8)}.ds-die{display:block;margin:24px auto;width:clamp(220px,min(23vw,36svh),480px);max-width:80%;height:auto;transform:rotate(-8deg)}.ds-die rect{fill:none;stroke:var(--ink,#f1f0e8);stroke-width:3}.ds-die circle{fill:var(--ink,#f1f0e8)}.ds-die-result p{font:16px/1.5 Apfel,sans-serif;color:var(--muted,#a3a59b);margin:24px 0 0}@media(max-width:760px),(min-width:761px) and (max-height:650px){.ds-die{width:200px}}"
