  "narrative": {
    "northStar": "A chance print",
    "overview": "A chance print. The answer is the artwork: expressive Basteleur numerals or a spare outlined die on a flat, nearly black ground. Apfel brings a quiet, direct voice to the controls and explanation. Warm salmon marks the action and a brief discharge; it never becomes a background atmosphere.\n\nThis system uses scale, asymmetry, generous space and a few fine rules. It has no enclosing tool card, generated background or continuous rendering loop. The implemented reference is public/index.html, public/style.css and public/app.js; the generator composition belongs to its surface brief.",
    "keyCharacteristics": [
      "Nearly black ground, warm white type and restrained salmon.",
      "Self-hosted Basteleur Bold and Apfel Grotezk Regular.",
      "An oversized, fully contained answer with quiet controls.",
      "One brief, result-triggered motion sequence."
    ],
    "rules": [
      {
        "name": "The Single Accent Rule",
        "body": "Use salmon for action, selected indicators, focus, errors, stale-data status and the brief discharge. Keep the reading ground neutral.",
        "section": "colors"
      },
      {
        "name": "The Contained Answer Rule",
        "body": "The complete answer must fit its own column. Preserve the 68cqw cap for one or two digits and the 44cqw cap for three digits in every layout.",
        "section": "typography"
      },
      {
        "name": "The Flat Ground Rule",
        "body": "Separate content through space, scale and fine rules; do not add elevation to the generator.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** make the answer the strongest visual element and keep every digit inside its result container.",
      "**Do** use the self-hosted typefaces and preserve the quiet, open control treatment.",
      "**Do** adapt wide, narrow and short screens with real layout changes.",
      "**Do** retain visible focus, live status, loading, error and reduced-motion states.",
      "**Do** tie source age and exported provenance to the displayed result."
    ],
    "donts": [
      "**Don't** restore the discarded dark ASCII atmosphere, generated wallpaper or continuous visual animation.",
      "**Don't** add cards, shadows, gradients or decorative fields around the generator.",
      "**Don't** size the result from viewport width alone or clip the three-digit answer.",
      "**Don't** present the salmon discharge as an observed lightning path or a recent snapshot as a live stream."
    ]
  }
