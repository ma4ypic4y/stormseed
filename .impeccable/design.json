      "html": "<div class=\"ds-modes\" role=\"group\" aria-label=\"What to generate\"><button type=\"button\" aria-pressed=\"true\">1–100</button><button type=\"button\" aria-pressed=\"false\">Dice</button></div>",
      "css": ".ds-modes{display:flex;gap:32px;align-items:center}.ds-modes button{font-family:Apfel,sans-serif;border:0;background:none;padding:0;color:var(--ink,#f1f0e8);cursor:pointer;min-height:44px;transition:color .18s ease;position:relative;font-size:18px;padding-left:17px;color:var(--muted,#a3a59b)}.ds-modes button:before{content:\"\";position:absolute;left:0;top:50%;width:6px;height:6px;border-radius:50%;background:transparent;transform:translateY(-50%)}.ds-modes button[aria-pressed=true]{color:var(--ink,#f1f0e8)}.ds-modes button[aria-pressed=true]:before,.ds-modes button:hover:before{background:var(--red,#f0785c)}.ds-modes button:hover{color:var(--red,#f0785c)}.ds-modes button:disabled{opacity:.5;cursor:wait}.ds-modes button:focus-visible{outline:2px solid var(--red,#f0785c);outline-offset:7px}@media(prefers-reduced-motion:reduce){.ds-modes button{transition:none}}"
